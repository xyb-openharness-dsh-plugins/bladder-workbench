{
  "name": "@xyb-community/bladder-cancer-workbench",
  "version": "0.1.0",
  "description": "面向膀胱癌患者与照护者的本机优先工作台：NMIBC/MIBC 分野读懂、TURBT 与二次电切、膀胱灌注周期、膀胱镜复查与复发恐惧、尿流改道三术式与造口日常、肾功能与上尿路长期监测、复诊准备与临床试验档案",
  "private": true,
  "type": "module",
  "main": "./dsh/index.js",
  "exports": {
    ".": "./dsh/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "dsh",
    "lib",
    "assets",
    "cordis.patch.yml",
    "README.md",
    "NOTICE.md"
  ],
  "scripts": {
    "check": "node --check dsh/index.js && node --check lib/client.js && node scripts/check-workbench-package.mjs .",
    "pack:check": "npm pack --dry-run"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "dsh-desktop-workbenches"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/xyb-openharness-dsh-plugins/bladder-cancer-workbench"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1 <5",
    "@deepseek-ai/dsh-client-connection": ">=0.1.0-rc.0 <0.3.0-0",
    "@deepseek-ai/dsh-host-webserver": ">=0.1.0-rc.0 <0.3.0-0",
    "@deepseek-ai/schemastery": ">=3.18.1 <4"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "UNLICENSED"
}
