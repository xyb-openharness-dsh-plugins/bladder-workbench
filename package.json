{
  "name": "@xyb-community/bladder-workbench",
  "version": "0.1.0",
  "description": "面向膀胱癌患者与照护者的本机优先工作台：NMIBC/MIBC 分野读懂、TURBT 与二次电切、膀胱灌注周期、膀胱镜复查与复发恐惧、尿流改道三术式与造口日常、肾功能与上尿路长期监测、复诊准备与临床试验档案",
  "private": true,
  "type": "module",
  "main": "./dsh/index.js",
  "exports": {
    ".": "./dsh/index.js",
    "./client": "./lib/client.js",
    "./layout": "./lib/layout.js",
    "./version": "./lib/version.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "dsh",
    "demo",
    "lib",
    "public",
    "schema",
    "assets",
    "cordis.patch.yml",
    "VERSION",
    "README.md",
    "NOTICE.md"
  ],
  "//": "检查链说明：check 是「代码层全绿」的单一入口，必须无外部依赖（不装机、不联网）。check:install 与 probe:headless 需要真实环境，单独跑：前者要装进 Desktop profile（M6），后者的数字不能代替 parity。build:public 由原型生成开发版前端，改原型后要重跑。",
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning scripts/dev-server.mjs",
    "build:version": "UROPAL_CHANNEL=beta node scripts/build-version.mjs",
    "build:client": "node scripts/build-client.mjs",
    "build:public": "node scripts/build-public.mjs",
    "build:demo": "node demo/build-demo-data.mjs",
    "check:version": "UROPAL_CHANNEL=beta node scripts/build-version.mjs --check",
    "check:client": "node scripts/build-client.mjs --check",
    "check:public": "node scripts/build-public.mjs --check",
    "check:demo": "node demo/build-demo-data.mjs --check",
    "check:syntax": "node scripts/check-syntax.mjs",
    "check:schema": "node scripts/check-schema.mjs",
    "check:wording": "node scripts/check-wording.mjs",
    "check:package": "node scripts/check-workbench-package.mjs .",
    "check:install": "node scripts/check-install.mjs",
    "probe:headless": "node --disable-warning=ExperimentalWarning scripts/probe-headless.mjs",
    "probe:install": "node scripts/probe-install.mjs",
    "install:local": "node scripts/install-local.mjs",
    "test": "node --disable-warning=ExperimentalWarning --test test/*.test.mjs",
    "check": "npm run check:version && npm run check:client && npm run check:public && npm run check:demo && npm run check:syntax && npm run check:schema && npm run check:wording && npm run check:package && npm test",
    "pack:check": "npm pack --dry-run"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "dsh-desktop-workbenches"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/xyb-openharness-dsh-plugins/bladder-workbench"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1 <5",
    "@deepseek-ai/dsh-client-connection": ">=0.1.0-rc.0 <0.3.0-0",
    "@deepseek-ai/dsh-host-webserver": ">=0.1.0-rc.0 <0.3.0-0",
    "@deepseek-ai/schemastery": ">=3.18.1 <4"
  },
  "engines": {
    "node": ">=22.5"
  },
  "license": "UNLICENSED"
}
